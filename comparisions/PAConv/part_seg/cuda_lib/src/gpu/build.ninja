ninja_required_version = 1.3
cxx = c++
nvcc = /config/workspace/cuda/cuda-11.8/bin/nvcc

cflags = -DTORCH_EXTENSION_NAME=gpconv_cuda -DTORCH_API_INCLUDE_EXTENSION_H -DPYBIND11_COMPILER_TYPE=\"_gcc\" -DPYBIND11_STDLIB=\"_libstdcpp\" -DPYBIND11_BUILD_ABI=\"_cxxabi1011\" -isystem /config/workspace/miniconda3/envs/PointNeXt/lib/python3.7/site-packages/torch/include -isystem /config/workspace/miniconda3/envs/PointNeXt/lib/python3.7/site-packages/torch/include/torch/csrc/api/include -isystem /config/workspace/miniconda3/envs/PointNeXt/lib/python3.7/site-packages/torch/include/TH -isystem /config/workspace/miniconda3/envs/PointNeXt/lib/python3.7/site-packages/torch/include/THC -isystem /config/workspace/cuda/cuda-11.8/include -isystem /config/workspace/miniconda3/envs/PointNeXt/include/python3.7m -D_GLIBCXX_USE_CXX11_ABI=0 -fPIC -std=c++14
post_cflags = 
cuda_cflags = -DTORCH_EXTENSION_NAME=gpconv_cuda -DTORCH_API_INCLUDE_EXTENSION_H -DPYBIND11_COMPILER_TYPE=\"_gcc\" -DPYBIND11_STDLIB=\"_libstdcpp\" -DPYBIND11_BUILD_ABI=\"_cxxabi1011\" -isystem /config/workspace/miniconda3/envs/PointNeXt/lib/python3.7/site-packages/torch/include -isystem /config/workspace/miniconda3/envs/PointNeXt/lib/python3.7/site-packages/torch/include/torch/csrc/api/include -isystem /config/workspace/miniconda3/envs/PointNeXt/lib/python3.7/site-packages/torch/include/TH -isystem /config/workspace/miniconda3/envs/PointNeXt/lib/python3.7/site-packages/torch/include/THC -isystem /config/workspace/cuda/cuda-11.8/include -isystem /config/workspace/miniconda3/envs/PointNeXt/include/python3.7m -D_GLIBCXX_USE_CXX11_ABI=0 -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr -gencode=arch=compute_86,code=compute_86 -gencode=arch=compute_86,code=sm_86 --compiler-options '-fPIC' -std=c++14
cuda_post_cflags = 
ldflags = -shared -L/config/workspace/miniconda3/envs/PointNeXt/lib/python3.7/site-packages/torch/lib -lc10 -lc10_cuda -ltorch_cpu -ltorch_cuda_cu -ltorch_cuda_cpp -ltorch -ltorch_python -L/config/workspace/cuda/cuda-11.8/lib64 -lcudart

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc  $cuda_cflags -c $in -o $out $cuda_post_cflags

rule link
  command = $cxx $in $ldflags -o $out

build operator.o: compile /config/workspace/wc/PAConv/part_seg/cuda_lib/src/gpu/operator.cpp
build assign_score_withk_gpu.cuda.o: cuda_compile /config/workspace/wc/PAConv/part_seg/cuda_lib/src/gpu/assign_score_withk_gpu.cu

build gpconv_cuda.so: link operator.o assign_score_withk_gpu.cuda.o

default gpconv_cuda.so

